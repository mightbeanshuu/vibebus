{
  "name": "vibebus",
  "version": "2.1.0",
  "description": "A real-time, bidirectional MCP bus that lets CLI coding agents message, wake, question, and coordinate with each other.",
  "type": "module",
  "bin": {
    "vibebus-mcp": "./bin/vibebus-mcp.js",
    "vibebus": "./bin/vibebus.js",
    "cli-team-mcp": "./bin/vibebus-mcp.js",
    "cli-team": "./bin/vibebus.js"
  },
  "scripts": {
    "build": "for f in src/*.js bin/*.js skills/vibebus/scripts/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "cli",
    "agents",
    "coordination",
    "codex",
    "claude",
    "gemini",
    "antigravity",
    "grok",
    "windsurf",
    "qwen",
    "aider",
    "goose",
    "handoff",
    "skill",
    "realtime",
    "bidirectional",
    "sampling",
    "elicitation",
    "multi-agent",
    "orchestration",
    "wake"
  ],
  "author": "Anshu <amananshu2004@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "assets",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
